-- ==================== MODULE HOOK SYSTEM ====================
local hookedModules = {}
local hookedRemotes = {}
local hookedValues = {}

local function HookAll()
    for _, obj in pairs(game:GetDescendants()) do
        pcall(function()
            if obj:IsA("ModuleScript") then
                local n = obj.Name:lower()
                if n:find("gamepass") or n:find("bypass") or n:find("market")
                   or n:find("purchase") or n:find("premium") or n:find("vip")
                   or n:find("owned") or n:find("setting") or n:find("config")
                   or n:find("ban") or n:find("detect") or n:find("anti")
                   or n:find("player") or n:find("weapon") or n:find("gun") then
                    local ok, data = pcall(require, obj)
                    if ok and type(data) == "table" then
                        hookedModules[obj] = data
                    end
                end
            end
        end)
    end

    for _, obj in pairs(game:GetDescendants()) do
        pcall(function()
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("gamepass") or n:find("purchase") or n:find("buy")
                   or n:find("premium") or n:find("vip") or n:find("owned")
                   or n:find("check") or n:find("detect") or n:find("ban")
                   or n:find("kick") or n:find("report") then
                    hookedRemotes[obj] = obj
                end
            end
        end)
    end

    for _, obj in pairs(game:GetDescendants()) do
        pcall(function()
            if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("BoolValue") or obj:IsA("StringValue") then
                local n = obj.Name:lower()
                if n:find("gamepass") or n:find("owned") or n:find("premium")
                   or n:find("vip") or n:find("pass") or n:find("ban")
                   or n:find("detect") or n:find("flag") or n:find("warn") then
                    hookedValues[obj] = obj
                end
            end
        end)
    end
end

task.spawn(function()
    task.wait(2)
    HookAll()
    print("[RENXX] Hooked: " .. #hookedModules .. " modules, " .. #hookedRemotes .. " remotes, " .. #hookedValues .. " values")
end)

