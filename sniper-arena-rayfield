-- ==================== DRAWING POOL ====================
local pool = {line={}, text={}, square={}}
local activeCount = {line=0, text=0, square=0}

local function getDrawing(dtype)
    activeCount[dtype] = activeCount[dtype] + 1
    local idx = activeCount[dtype]
    if not pool[dtype][idx] then
        pool[dtype][idx] = Drawing.new(dtype == "line" and "Line" or dtype == "text" and "Text" or "Square")
    end
    return pool[dtype][idx]
end

local function resetPool()
    for dtype, list in pairs(pool) do
        for i = 1, #list do
            if i > activeCount[dtype] then list[i].Visible = false end
        end
    end
    activeCount.line = 0
    activeCount.text = 0
    activeCount.square = 0
end

-- ==================== GET CLOSEST TARGET ====================
local function getClosestTarget(fovRange)
    local closest, shortest = nil, math.huge
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not isSameTeam(p) then
            local part = p.Character:FindFirstChild(C.AimPart)
            if part and hasLineOfSight(part) then
                local sp, on = Cam:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < fovRange and d < shortest then
                        shortest = d
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

-- ==================== ESP SKELETON ====================
local function drawSkeleton(char, color)
    local parts = {
        Head = char:FindFirstChild("Head"),
        UpperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        LowerTorso = char:FindFirstChild("LowerTorso"),
        LeftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm"),
        RightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"),
        LeftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg"),
        RightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg"),
        HRP = char:FindFirstChild("HumanoidRootPart"),
    }
    if not parts.Head or not parts.HRP then return end

    local conns = {
        {parts.Head, parts.UpperTorso or parts.HRP},
        {parts.UpperTorso or parts.HRP, parts.LowerTorso or parts.HRP},
        {parts.UpperTorso or parts.HRP, parts.LeftArm},
        {parts.UpperTorso or parts.HRP, parts.RightArm},
        {parts.LowerTorso or parts.HRP, parts.LeftLeg},
        {parts.LowerTorso or parts.HRP, parts.RightLeg},
    }
    for _, conn in pairs(conns) do
        local a, b = conn[1], conn[2]
        if a and b then
            local sp1, on1 = Cam:WorldToViewportPoint(a.Position)
            local sp2, on2 = Cam:WorldToViewportPoint(b.Position)
            if on1 and on2 then
                local l = getDrawing("line")
                l.From = Vector2.new(sp1.X, sp1.Y)
                l.To = Vector2.new(sp2.X, sp2.Y)
                l.Color = color
                l.Thickness = 2
                l.Visible = true
            end
        end
    end
end

-- ==================== MODULE HOOK (ALL) ====================
local hookedModules = {}

local function hookAllModules()
    local count = 0
    for _, obj in pairs(RS:GetDescendants()) do
        pcall(function()
            if obj:IsA("ModuleScript") then
                local n = obj.Name:lower()
                if n:find("gun") or n:find("weapon") or n:find("sniper") or n:find("setting")
                   or n:find("config") or n:find("aim") or n:find("fire") or n:find("hit")
                   or n:find("speed") or n:find("player") or n:find("character") then
                    local ok, data = pcall(require, obj)
                    if ok and type(data) == "table" then
                        hookedModules[obj] = data
                        count = count + 1
                    end
                end
            end
        end)
    end
    return count
end

task.spawn(function()
    task.wait(2)
    local count = hookAllModules()
    if count > 0 then
        print("[RENXX] "..count.." modules hooked")
    end
end)

-- Apply mods ke module yang di-hook
local function applyModuleMods()
    for _, settings in pairs(hookedModules) do
        pcall(function()
            for k, v in pairs(settings) do
                local kn = tostring(k):lower()
                if C.NoRecoil and (kn:find("recoil") or kn:find("kick")) then settings[k] = 0 end
                if C.NoSpread and (kn:find("spread") or kn:find("inaccuracy")) then settings[k] = 0 end
                if C.FireRate and (kn:find("firerate") or kn:find("cooldown")) then settings[k] = math.max(0.01, 1/C.FireRateValue) end
                if C.OneHit and (kn:find("damage") or kn:find("dmg")) and type(v) == "number" then settings[k] = 9999 end
                if C.HighRange and (kn:find("range") or kn:find("distance")) then settings[k] = 99999 end
                if C.SpeedHack and kn:find("walkspeed") then settings[k] = C.SpeedValue end
                if C.GodMode and kn:find("health") and type(v) == "number" then settings[k] = math.huge end
            end
        end)
    end
end

