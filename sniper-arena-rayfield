-- ==================== WEAPON MODS LOOP ====================
local function applyWeaponValues()
    if not LP.Character then return end
    for _, tool in pairs(LP.Character:GetChildren()) do
        if tool:IsA("Tool") then
            for _, obj in pairs(tool:GetDescendants()) do
                pcall(function()
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("DoubleConstrainedValue") then
                        local n = obj.Name:lower()
                        if C.NoRecoil and (n:find("recoil") or n:find("kick")) then obj.Value = 0 end
                        if C.NoSpread and (n:find("spread") or n:find("inaccuracy")) then obj.Value = 0 end
                        if C.FireRate and (n:find("firerate") or n:find("cooldown")) then obj.Value = math.max(0.01, 1/C.FireRateValue) end
                        if C.HighRange and (n:find("range") or n:find("distance")) then obj.Value = 99999 end
                        if C.OneHit and (n:find("damage") or n:find("dmg")) then obj.Value = 9999 end
                    end
                end)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        pcall(applyModuleMods)
        pcall(applyWeaponValues)
    end
end)

