-- ==================== HOOK ====================
if hasHook then
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    local newc = newcclosure or function(f) return f end

    mt.__namecall = newc(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if not method then return oldNamecall(self, ...) end

        -- V1: RemoteEvent + Hybrid (Ping + Velocity)
        if C.V1_SilentAim and v1Target and v1Target.Character and method == "FireServer" then
            if typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                local part = v1Target.Character:FindFirstChild(C.V1_AimPart)
                local hrp = v1Target.Character:FindFirstChild("HumanoidRootPart")
                if part and hrp then
                    local pingSec = getPingInSeconds()
                    local totalDelay = pingSec + C.V1_PingBuffer
                    local aimPos = part.Position + (hrp.Velocity * totalDelay)
                    for i = 1, #args do
                        if typeof(args[i]) == "Vector3" then args[i] = aimPos end
                    end
                end
            end
        end

        -- V2: RemoteFunction + Velocity
        if C.V2_SilentAim and v2Target and v2Target.Character and method == "InvokeServer" then
            if typeof(self) == "Instance" and self:IsA("RemoteFunction") then
                local part = v2Target.Character:FindFirstChild(C.V2_AimPart)
                local hrp = v2Target.Character:FindFirstChild("HumanoidRootPart")
                if part and hrp then
                    local aimPos = part.Position + (hrp.Velocity * 0.15)
                    for i = 1, #args do
                        if typeof(args[i]) == "Vector3" then
                            args[i] = aimPos
                        elseif typeof(args[i]) == "CFrame" then
                            args[i] = CFrame.new(aimPos)
                        elseif typeof(args[i]) == "table" then
                            for k, v in pairs(args[i]) do
                                if typeof(v) == "Vector3" then args[i][k] = aimPos
                                elseif typeof(v) == "CFrame" then args[i][k] = CFrame.new(aimPos)
                                elseif k == "hitPart" or k == "target" then args[i][k] = part end
                            end
                        end
                    end
                end
            end
        end

        return oldNamecall(self, unpack(args))
    end)

    setreadonly(mt, true)
end

