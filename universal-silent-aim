-- ==================== ESP DRAWING MANAGER ====================
-- Simpan drawing object per player
local espDrawings = {} -- [player] = { line=, name=, hpBG=, hpBar=, dist=, box=, skeletonLines={} }

local function createESPFor(player)
    if not hasDrawing then return end
    espDrawings[player] = {
        line = Drawing.new("Line"),
        name = Drawing.new("Text"),
        hpBG = Drawing.new("Square"),
        hpBar = Drawing.new("Square"),
        dist = Drawing.new("Text"),
        box = Drawing.new("Square"),
        skeleton = {},
    }
    -- Skeleton parts (11 titik, 10 garis)
    local parts = {"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"}
    for i = 1, 10 do
        espDrawings[player].skeleton[i] = Drawing.new("Line")
    end
    -- Hide all dulu
    local d = espDrawings[player]
    d.line.Visible = false
    d.name.Visible = false
    d.hpBG.Visible = false
    d.hpBar.Visible = false
    d.dist.Visible = false
    d.box.Visible = false
    for _, s in pairs(d.skeleton) do s.Visible = false end
end

local function removeESPFor(player)
    if espDrawings[player] then
        local d = espDrawings[player]
        pcall(function() d.line:Remove() end)
        pcall(function() d.name:Remove() end)
        pcall(function() d.hpBG:Remove() end)
        pcall(function() d.hpBar:Remove() end)
        pcall(function() d.dist:Remove() end)
        pcall(function() d.box:Remove() end)
        for _, s in pairs(d.skeleton) do pcall(function() s:Remove() end) end
        espDrawings[player] = nil
    end
end

local function hideESPFor(player)
    if espDrawings[player] then
        local d = espDrawings[player]
        d.line.Visible = false
        d.name.Visible = false
        d.hpBG.Visible = false
        d.hpBar.Visible = false
        d.dist.Visible = false
        d.box.Visible = false
        for _, s in pairs(d.skeleton) do s.Visible = false end
    end
end

