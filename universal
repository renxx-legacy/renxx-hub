-- ==================== MAIN LOOP ====================
local fpsCount = 0
local fpsTime = tick()

RunService.Heartbeat:Connect(function()
    fpsCount = fpsCount + 1
    if tick() - fpsTime >= 1 then
        if C.ShowFPS then print("[RENXX FPS] " .. fpsCount) end
        fpsCount = 0
        fpsTime = tick()
    end

    if not LP.Character then return end
    local h = LP.Character:FindFirstChildOfClass("Humanoid")
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not h then return end

    if C.GodMode then h.Health = h.MaxHealth end
    if C.SpeedHack and h.WalkSpeed ~= C.SpeedValue then h.WalkSpeed = C.SpeedValue end
    if C.JumpHack then
        h.UseJumpPower = true
        if h.JumpPower ~= C.JumpValue then h.JumpPower = C.JumpValue end
    end
    if C.BunnyHop and h:GetState() == Enum.HumanoidStateType.Landed then
        h:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    if C.NoClip then
        for _, p in pairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end
    if C.Fly and hrp then
        if not hrp:FindFirstChild("RENXX_FlyV") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "RENXX_FlyV"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = hrp
        end
        local md = Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - Cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then md = md - Vector3.new(0,1,0) end
        hrp.RENXX_FlyV.Velocity = md * C.FlySpeed
    else
        if hrp then
            local bv = hrp:FindFirstChild("RENXX_FlyV")
            if bv then bv:Destroy() end
        end
    end
end)

