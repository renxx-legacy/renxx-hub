    Fullbright=false, NoFog=false, RemoveParticle=false, SkyColor=Color3.fromRGB(0,0,0),
    -- Player
    SpeedHack=false, SpeedValue=30, JumpHack=false, JumpValue=50, InfJump=false, BunnyHop=false,
    NoClip=false, Fly=false, FlySpeed=50,
    -- Game
    SelectedPlayer="(Pilih Player)", FreezeNPC=false
}

