    Content = "Fitur bypass & proteksi client-side.\n\n⚠️ Resiko ban tinggi, gunakan di akun alt!"
})
ProtTab:AddDivider()

ProtTab:AddButton({
    Title = "Bypass",
    Description = "Anti-Kick basic",
    Callback = function()
        if not hasHook then Fluent:Notify({Title="Bypass", Content="❌ Hook tidak support", Duration=3}) return end
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                if getnamecallmethod() == "Kick" and self == LP then return nil end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
        end)
        Fluent:Notify({Title="Bypass", Content="✅ Anti-Kick Aktif", Duration=3})
    end
})

ProtTab:AddButton({
    Title = "Bypass V2",
    Description = "Anti-Detect + Blokir Remote",
    Callback = function()
        if not hasHook then Fluent:Notify({Title="Bypass V2", Content="❌ Hook tidak support", Duration=3}) return end
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                local args = {...}
                if method == "Kick" and self == LP then return nil end
                if method == "SetPrimaryPartCFrame" or method == "SetNetworkOwner" then return nil end
                if method == "FireServer" then
                    local rn = self.Name:lower()
                    if rn:find("detect") or rn:find("ban") or rn:find("kick") or rn:find("report") or rn:find("flag") then return nil end
                end
                return oldNamecall(self, unpack(args))
            end)
            setreadonly(mt, true)
        end)
        Fluent:Notify({Title="Bypass V2", Content="✅ Anti-Detect Aktif", Duration=3})
    end
})

ProtTab:AddToggle("Speed_Bypass", { Title = "Speed Bypass", Default = false, Callback = function(v)
    C.SpeedBypass = v
    if v and hasHook then
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldIndex = mt.__index
            mt.__index = newcclosure(function(self, key)
                if key == "WalkSpeed" and self:IsA("Humanoid") and self.Parent == LP.Character then
                    return C.SpeedValue
                end
                return oldIndex(self, key)
            end)
            setreadonly(mt, true)
        end)
    end
end })
