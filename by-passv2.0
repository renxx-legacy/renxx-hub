-- ==================== HIGHLIGHT ESP LOOP ====================
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if C.HighlightESP then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local hl = p.Character:FindFirstChild("RENXX_HL")
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "RENXX_HL"
                            hl.Parent = p.Character
                        end
                        hl.FillColor = (p.Team and LP.Team and p.Team == LP.Team) and C.TeamHighlight or C.EnemyHighlight
                        hl.OutlineColor = Color3.fromRGB(255,255,255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                    end
                end
                for _, obj in pairs(workspace:GetChildren()) do
                    pcall(function()
                        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                            local hl = obj:FindFirstChild("RENXX_HL_NPC")
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "RENXX_HL_NPC"
                                hl.Parent = obj
                            end
                            hl.FillColor = C.NPCHighlight
                            hl.OutlineColor = Color3.fromRGB(255,255,255)
                            hl.FillTransparency = 0.5
                        end
                    end)
                end
            else
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character then
                        local hl = p.Character:FindFirstChild("RENXX_HL")
                        if hl then hl:Destroy() end
                    end
                end
                for _, obj in pairs(workspace:GetChildren()) do
                    pcall(function()
                        if obj:IsA("Model") then
                            local hl = obj:FindFirstChild("RENXX_HL_NPC")
                            if hl then hl:Destroy() end
                        end
                    end)
                end
            end
        end)
    end
end)

-- ==================== FLY SYSTEM ====================
local flyBV, flyBG

local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

-- ==================== PLAYER LOOP (FIXED) ====================
RunService.Heartbeat:Connect(function()
    pcall(function()
        if LP.Character then
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h then
                -- Speed Hack
                if C.SpeedHack then
                    if h.WalkSpeed ~= C.SpeedValue then h.WalkSpeed = C.SpeedValue end
                else
                    if h.WalkSpeed ~= 16 then h.WalkSpeed = 16 end
                end

                -- Jump Hack
                if C.JumpHack then
                    h.UseJumpPower = true
                    if h.JumpPower ~= C.JumpValue then h.JumpPower = C.JumpValue end
                else
                    if h.JumpPower ~= 50 then h.UseJumpPower = true; h.JumpPower = 50 end
                end

                -- Bunny Hop
                if C.BunnyHop and h:GetState() == Enum.HumanoidStateType.Landed then
                    h:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end

            -- Fly (pakai BodyVelocity)
            if C.Fly and LP.Character:FindFirstChild("HumanoidRootPart") then
                local root = LP.Character.HumanoidRootPart
                if not flyBV then
                    flyBV = Instance.new("BodyVelocity")
                    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    flyBV.Parent = root
                end
                if not flyBG then
                    flyBG = Instance.new("BodyGyro")
                    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    flyBG.P = 1000
                    flyBG.Parent = root
                end
                local dir = Vector3.new()
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
                flyBV.Velocity = dir * C.FlySpeed
                flyBG.CFrame = Cam.CFrame
            else
                stopFly()
            end

            -- No Clip
            if C.NoClip then
                for _, p in pairs(LP.Character:GetDescendants()) do
                    pcall(function() if p:IsA("BasePart") then p.CanCollide = false end end)
                end
            end
        end
    end)
end)

-- ==================== INFINITE JUMP (FIXED) ====================
UIS.JumpRequest:Connect(function()
    if C.InfJump and LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- ==================== RESPAWN HANDLER ====================
LP.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if C.SpeedHack then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = C.SpeedValue end
    end
    if C.JumpHack then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then h.UseJumpPower = true; h.JumpPower = C.JumpValue end
    end
    stopFly()
end)

-- ==================== FREEZE NPC LOOP ====================
task.spawn(function()
    while task.wait(0.3) do
        pcall(function()
            if C.FreezeNPC then
                for _, obj in pairs(workspace:GetChildren()) do
                    pcall(function()
                        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                            local h = obj:FindFirstChildOfClass("Humanoid")
                            if h then
                                h.WalkSpeed = 0
                                h.JumpPower = 0
                                h.UseJumpPower = true
                            end
                        end
                    end)
                end
            end
        end)
    end
end)

-- ==================== PLAYER LIST UPDATER ====================
task.spawn(function()
    while task.wait(3) do
        pcall(function()
            local playerList = {"(Pilih Player)"}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP then
                    table.insert(playerList, p.Name)
                end
            end
            if PlayerDropdown and PlayerDropdown.SetValues then
                PlayerDropdown:SetValues(playerList)
            end
        end)
    end
end)

