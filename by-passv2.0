GpTab:AddButton({
    Title = "Scan Gamepass",
    Description = "Lihat gamepass di game ini",
    Callback = function()
        local passes = {}
        pcall(function() passes = MarketplaceService:GetGamePassesAsync(game.PlaceId) end)
        if not passes or #passes == 0 then Fluent:Notify({Title="Scan", Content="❌ Gamepass tidak ditemukan", Duration=5}) return end
        local list = "📋 Gamepass:\n"
        for i, pass in pairs(passes) do
            list = list .. i .. ". " .. pass.Name .. " (ID: " .. pass.ProductId .. ")\n"
        end
        Fluent:Notify({Title="Scan Gamepass", Content=list, Duration=8})
    end
})

GpTab:AddButton({
    Title = "Free Gamepass V1",
    Description = "Prompt + Module Injection",
    Callback = function()
        local count, injected = 0, 0
        local success, passes = pcall(function() return MarketplaceService:GetGamePassesAsync(game.PlaceId) end)
        if success then
            for _, pass in pairs(passes) do
                pcall(function()
                    MarketplaceService:PromptGamePassPurchase(LP, pass.ProductId)
                    task.wait(0.3)
                    MarketplaceService:SignalPromptGamePassPurchaseFinished(LP, pass.ProductId, true)
                    count = count + 1
                end)
            end
        end
        for _, obj in pairs(game:GetDescendants()) do
            pcall(function()
                if obj:IsA("ModuleScript") then
                    local n = obj.Name:lower()
                    if n:find("gamepass") or n:find("market") or n:find("shop") or n:find("purchase") or n:find("premium") or n:find("pass") then
                        local ok, data = pcall(require, obj)
                        if ok and type(data) == "table" then
                            for k, v in pairs(data) do
                                if type(v) == "boolean" then data[k] = true; injected = injected + 1
                                elseif type(v) == "number" then data[k] = 9999; injected = injected + 1
                                elseif type(v) == "function" then data[k] = function(...) return true end; injected = injected + 1 end
                            end
                        end
                    end
                end
            end)
        end
        Fluent:Notify({Title="Gamepass V1", Content="✅ " .. count .. " prompt, " .. injected .. " value di-inject", Duration=5})
    end
})

GpTab:AddButton({
    Title = "Free Gamepass V2",
    Description = "Hook UserOwnsGamePassAsync (Paling Works!)",
    Callback = function()
        if not hasHook then Fluent:Notify({Title="Gamepass V2", Content="❌ Hook tidak support", Duration=3}) return end
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                local args = {...}
                if method == "UserOwnsGamePassAsync" then return true end
                if method == "GetGamePassProductInfo" then return {IsForSale = true, PriceInRobux = 0} end
                if method == "PlayerOwnsAsset" then return true end
                return oldNamecall(self, unpack(args))
            end)
            setreadonly(mt, true)
        end)
        Fluent:Notify({Title="Gamepass V2", Content="✅ Hook Aktif!", Duration=3})
    end
})

