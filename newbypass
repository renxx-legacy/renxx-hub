local function DoBypassV1()
    if not hasHook then return "❌ Hook tidak support" end
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "Kick" and self == LP then return nil end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
    return "✅ Bypass V1 Aktif (Anti-Kick)"
end

local function DoBypassV2()
    if not hasHook then return "❌ Hook tidak support" end
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if method == "Kick" and self == LP then return nil end
            if method == "SetPrimaryPartCFrame" or method == "SetNetworkOwner" then return nil end
            if method == "FireServer" then
                local rn = self.Name:lower()
                if rn:find("detect") or rn:find("ban") or rn:find("kick") or rn:find("report") or rn:find("flag") then return nil end
            end
            return old(self, unpack(args))
        end)
        setreadonly(mt, true)
    end)
    return "✅ Bypass V2 Aktif (Anti-Detect)"
end

