-- ==================== MODULE HOOK SYSTEM ====================
local hookedModules = {}
local hookedRemotes = {}

local function hookAllModules()
    local count = 0
    for _, obj in pairs(RS:GetDescendants()) do
        pcall(function()
            if obj:IsA("ModuleScript") then
                local n = obj.Name:lower()
                if n:find("gamepass") or n:find("bypass") or n:find("marketplace")
                   or n:find("purchase") or n:find("premium") or n:find("vip")
                   or n:find("owned") or n:find("player") or n:find("character")
                   or n:find("setting") or n:find("config") then
                    local ok, data = pcall(require, obj)
                    if ok and type(data) == "table" then
                        hookedModules[obj] = data
                        count = count + 1
                    end
                end
            end
        end)
    end
    return count
end

local function hookAllRemotes()
    local count = 0
    for _, obj in pairs(RS:GetDescendants()) do
        pcall(function()
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = obj.Name:lower()
                if n:find("gamepass") or n:find("purchase") or n:find("buy")
                   or n:find("premium") or n:find("vip") or n:find("owned")
                   or n:find("check") then
                    hookedRemotes[obj] = obj
                    count = count + 1
                end
            end
        end)
    end
    return count
end

