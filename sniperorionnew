-- ==================== WEAPON V2 LOOP (ModuleScript) ====================
local hookedModules = {}
local function hookModules()
    hookedModules = {}
    local containers = {RS}
    if LP.Character then
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then table.insert(containers, tool) end
    end
    for _, container in pairs(containers) do
        for _, obj in pairs(container:GetDescendants()) do
            pcall(function()
                if obj:IsA("ModuleScript") then
                    local n = obj.Name:lower()
                    if n:find("gun") or n:find("weapon") or n:find("setting") or n:find("sniper") or n:find("config") or n:find("data") then
                        local ok, data = pcall(require, obj)
                        if ok and type(data) == "table" then
                            hookedModules[obj] = data
                        end
                    end
                end
            end)
        end
    end
    print("[RENXX WEAPON V2] Hooked " .. #hookedModules .. " modules")
    if #hookedModules > 0 then
        OrionLib:MakeNotification({Name="RENXX WEAPON V2", Content=#hookedModules .. " module(s) hooked!", Time=3})
    end
end

task.spawn(function()
