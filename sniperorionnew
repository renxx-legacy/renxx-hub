                            elseif C.DamageMultiplier and (kn:find("damage") or kn:find("dmg")) then data[k] = val * C.DamageValue end
                            if C.ReloadSpeed and kn:find("reload") then data[k] = math.max(0.01, val / C.ReloadSpeedValue) end
