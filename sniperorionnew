-- ==================== SILENT AIM HOOK ====================
local silentTarget = nil
if hasHook then
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if C.SilentAim and silentTarget and method == "FireServer" then
                pcall(function()
                    local part = silentTarget.Character and silentTarget.Character:FindFirstChild(C.AimPart)
                    if part then
                        if args[1] and typeof(args[1]) == "Vector3" then args[1] = part.Position
                        elseif args[2] and typeof(args[2]) == "Vector3" then args[2] = part.Position end
                    end
                end)
            end
            return old(self, unpack(args))
        end)
        setreadonly(mt, true)
    end)
end

-- ==================== MAIN RENDER LOOP ====================
RunService.RenderStepped:Connect(function()
    if fovCircle then
        if C.ShowFOV then
            fovCircle.Visible = true
            fovCircle.Position = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
            fovCircle.Radius = fovToRadius(C.AimbotFOV)
            fovCircle.Color = C.FOVColor
        else fovCircle.Visible = false end
    end

    if silentFovCircle then
        if C.ShowSilentFOV then
            silentFovCircle.Visible = true
            silentFovCircle.Position = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
            silentFovCircle.Radius = fovToRadius(C.SilentAimFOV)
            silentFovCircle.Color = Color3.fromRGB(255, 0, 0)
        else silentFovCircle.Visible = false end
    end

    local targetPlayer = nil
    if C.Aimbot and UIS.TouchEnabled then
        local target = getClosestTarget(fovToRadius(C.AimbotFOV))
        if target and target.Character then
            targetPlayer = target
            local part = target.Character:FindFirstChild(C.AimPart)
            if part then
                local targetCF = CFrame.new(Cam.CFrame.Position, part.Position)
                Cam.CFrame = Cam.CFrame:Lerp(targetCF, 1 / math.max(1, C.AimbotSmooth))
                if C.AutoFire then pcall(function() mouse1click() end) end
            end
        end
    end

    if C.SilentAim then silentTarget = getClosestTarget(fovToRadius(C.SilentAimFOV)) else silentTarget = nil end

    if targetDot then
        if C.ShowTarget and targetPlayer and targetPlayer.Character then
            local part = targetPlayer.Character:FindFirstChild(C.AimPart)
            if part then
                local sp, on = Cam:WorldToViewportPoint(part.Position)
                if on then targetDot.Visible = true; targetDot.Position = Vector2.new(sp.X, sp.Y)
                else targetDot.Visible = false end
            else targetDot.Visible = false end
        else targetDot.Visible = false end
    end

    clearDrawings()
    if C.ESP and hasDrawing then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    local sp, on = Cam:WorldToViewportPoint(hrp.Position)
                    if on then
                        if C.Highlight then
                            local hl = p.Character:FindFirstChild("RENXX_Highlight")
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "RENXX_Highlight"
                                hl.FillColor = isSameTeam(p) and C.TeamColor or C.EnemyColor
                                hl.OutlineColor = C.EnemyColor
                                hl.Parent = p.Character
                            end
                        elseif p.Character:FindFirstChild("RENXX_Highlight") then
                            p.Character:FindFirstChild("RENXX_Highlight"):Destroy()
                        end

                        if C.HitboxExpander then
                            for _, part in pairs(p.Character:GetDescendants()) do
                                pcall(function()
                                    if part:IsA("BasePart") and (part.Name == "Head" or part.Name == "HumanoidRootPart" or part.Name == "UpperTorso") then
                                        part.Size = Vector3.new(C.HitboxSize, C.HitboxSize, C.HitboxSize)
                                        part.Transparency = 0.7
                                        part.CanCollide = false
                                        part.Massless = true
                                    end
                                end)
                            end
                        end

                        if C.ESPLine then
                            local l = Drawing.new("Line")
                            l.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
                            l.To = Vector2.new(sp.X, sp.Y)
                            l.Color = isSameTeam(p) and C.TeamColor or C.EnemyColor
                            l.Thickness = 1; l.Visible = true
                            table.insert(drawings, l)
                        end
                        if C.ESPName then
                            local t = Drawing.new("Text")
                            t.Text = p.Name; t.Position = Vector2.new(sp.X, sp.Y - 40)
                            t.Color = C.TextColor; t.Size = 14; t.Center = true; t.Outline = true; t.Visible = true
                            table.insert(drawings, t)
                        end
                        if C.ESPDistance then
                            local dist = (hrp.Position - Cam.CFrame.Position).Magnitude
                            local t = Drawing.new("Text")
                            t.Text = math.floor(dist) .. "m"; t.Position = Vector2.new(sp.X, sp.Y + 30)
                            t.Color = C.TextColor; t.Size = 12; t.Center = true; t.Outline = true; t.Visible = true
                            table.insert(drawings, t)
                        end
                        if C.ESPHealth then
                            local t = Drawing.new("Text")
                            t.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                            t.Position = Vector2.new(sp.X, sp.Y + 45)
                            t.Color = C.HealthColor; t.Size = 12; t.Center = true; t.Outline = true; t.Visible = true
                            table.insert(drawings, t)
                        end
                        if C.ESPBox then
                            local b = Drawing.new("Square")
                            b.Size = Vector2.new(50, 80); b.Position = Vector2.new(sp.X - 25, sp.Y - 40)
                            b.Color = C.BoxColor; b.Thickness = 1; b.Filled = false; b.Visible = true
                            table.insert(drawings, b)
                        end
                        if C.ESPSkeleton then
                            local parts = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"}
                            local positions = {}
                            for _, partName in pairs(parts) do
                                local part = p.Character:FindFirstChild(partName)
                                if part then
                                    local psp, pon = Cam:WorldToViewportPoint(part.Position)
                                    if pon then positions[partName] = Vector2.new(psp.X, psp.Y) end
                                end
                            end
                            local connections = {
                                {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                                {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
                                {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
                                {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
                                {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
                            }
                            for _, conn in pairs(connections) do
                                if positions[conn[1]] and positions[conn[2]] then
                                    local sl = Drawing.new("Line")
                                    sl.From = positions[conn[1]]; sl.To = positions[conn[2]]
                                    sl.Color = C.SkeletonColor; sl.Thickness = 1; sl.Visible = true
                                    table.insert(drawings, sl)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ==================== HEARTBEAT LOOP ====================
RunService.Heartbeat:Connect(function()
    if LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then
            if C.GodMode then h.Health = h.MaxHealth end
            if C.SpeedHack then
                if h.WalkSpeed ~= C.SpeedValue then h.WalkSpeed = C.SpeedValue end
            elseif h.WalkSpeed ~= 16 then
                h.WalkSpeed = 16
            end
            if C.JumpHack then
                h.UseJumpPower = true
                if h.JumpPower ~= C.JumpValue then h.JumpPower = C.JumpValue end
            elseif h.JumpPower ~= 50 then
                h.UseJumpPower = true; h.JumpPower = 50
            end
            if C.BunnyHop then
                if h:GetState() == Enum.HumanoidStateType.Landed then
                    h:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
            if C.Fly then
                local rootPart = LP.Character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local moveDir = Vector3.new()
                    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Cam.CFrame.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Cam.CFrame.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                    if moveDir.Magnitude > 0 then
                        rootPart.Velocity = moveDir.Unit * C.FlySpeed
                    else
                        rootPart.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end
        if C.NoClip then
            for _, p in pairs(LP.Character:GetDescendants()) do
                pcall(function() if p:IsA("BasePart") then p.CanCollide = false end end)
            end
        end
        if C.AntiTeleport then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Velocity.Magnitude > 100 then
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

